# Firebase Admin — ID token verification (ADC preferred; not Google API keys)
FIREBASE_PROJECT_ID=a11y-hack26ath-267
GOOGLE_CLOUD_PROJECT=a11y-hack26ath-267
# Optional: path to a service-account JSON file on disk.
# On Vercel, point this at a file you materialize from a secret, or use workload identity if available.
# Prefer `gcloud auth application-default login` locally.
GOOGLE_APPLICATION_CREDENTIALS=

# Neon Postgres (EU eu-central-1) — file metadata + optional moment snapshots
DATABASE_URL=
DATA_REGION=eur3

# Gemini Developer API (prompts may leave the EU — see Privacy)
GEMINI_API_KEY=
GEMINI_DATA_REGION_NOTE=developer-api-global
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_VOICE=Sulafat
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
PUBLIC_URL=
CORS_ORIGINS=http://localhost:4321,https://anchor-w0nd3rland.vercel.app,https://anchor-api-teal.vercel.app
# When true, POST /api/* requires a valid Firebase ID token Bearer
REQUIRE_AUTH=false
# Optional: Vercel Blob (auto-injected on Vercel when store is linked)
BLOB_READ_WRITE_TOKEN=
