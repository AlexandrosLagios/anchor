# Firebase Admin uses Application Default Credentials (ADC) — not API keys.
# Org policy: do not create Google Cloud API keys for the API.
FIREBASE_PROJECT_ID=
GOOGLE_CLOUD_PROJECT=
# Optional: path to a service-account JSON file (workload identity / key file).
# This is NOT a Google API key. Prefer `gcloud auth application-default login` locally.
GOOGLE_APPLICATION_CREDENTIALS=

# Gemini Developer API still uses an API key today (separate from Firebase ADC).
# If your org also blocks this, switch to Vertex AI with ADC (see DEPLOY.md).
GEMINI_API_KEY=
# developer-api-global = Gemini Developer API; prompts may leave the EU (not Vertex EU)
GEMINI_DATA_REGION_NOTE=developer-api-global
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_VOICE=Sulafat
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
PUBLIC_URL=
CORS_ORIGINS=http://localhost:4321
# When true, POST /api/* requires a valid Firebase ID token
REQUIRE_AUTH=false
