GEMINI_API_KEY=
TWILIO_ACCOUNT_SID=
# Either the auth token, or an API key pair of the same account
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Optional: set when opening the dashboard from localhost instead of a tunnel URL
PUBLIC_URL=
# Comma-separated origins for local Astro (production uses same-origin Firebase rewrites)
CORS_ORIGINS=http://localhost:4321
