# Neon Postgres (EU eu-central-1) — required for accounts + file metadata
DATABASE_URL=
# HS256 secret for session JWTs (long random string)
AUTH_JWT_SECRET=
DATA_REGION=eu-central-1

# Gemini Developer API (prompts may leave the EU — see Privacy)
GEMINI_API_KEY=
GEMINI_DATA_REGION_NOTE=developer-api-global
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_VOICE=Sulafat
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
PUBLIC_URL=
CORS_ORIGINS=http://localhost:4321,https://anchor-open26.vercel.app,https://anchor-w0nd3rland.vercel.app,https://anchor-api-teal.vercel.app
# When true, POST /api/* requires a valid Bearer JWT
REQUIRE_AUTH=false
# Vercel Blob (auto-injected on Vercel when store is linked; copy token for local)
BLOB_READ_WRITE_TOKEN=

# Telegram family bot. Unset: the host starts no store, no tick, and no poll (the Vercel deploy leaves it unset)
TELEGRAM_BOT_TOKEN=
# Real seconds in one demo-clock day; the team test uses 120 or 600
ANCHOR_DAY_SECONDS=86400
ANCHOR_STATE_FILE=tmp/anchor-state.json
# Zone of the 11:00 and 18:00 slots; set it when the host runs in UTC
# TZ=Europe/Athens
