---
/**
 * Full-bleed geometric signal-line field for Variant D.
 * One continuous polyline motif: chat pulse / spaced retrieval return.
 */
---

<div class="signal-field" aria-hidden="true">
  <svg class="signal-svg" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice">
    <defs>
      <linearGradient id="signal-grad" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#1a6b5c" stop-opacity="0.15" />
        <stop offset="35%" stop-color="#3dff9a" stop-opacity="0.95" />
        <stop offset="65%" stop-color="#5eead4" stop-opacity="0.85" />
        <stop offset="100%" stop-color="#1a6b5c" stop-opacity="0.2" />
      </linearGradient>
      <filter id="signal-glow" x="-20%" y="-40%" width="140%" height="180%">
        <feGaussianBlur stdDeviation="4" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
    </defs>

    <!-- Construction grid — faint, geometric -->
    <g class="signal-grid" stroke="#1e3d38" stroke-width="1" fill="none">
      <line x1="0" y1="180" x2="1440" y2="180" />
      <line x1="0" y1="450" x2="1440" y2="450" />
      <line x1="0" y1="720" x2="1440" y2="720" />
      <line x1="240" y1="0" x2="240" y2="900" />
      <line x1="720" y1="0" x2="720" y2="900" />
      <line x1="1200" y1="0" x2="1200" y2="900" />
    </g>

    <!-- Primary signal line: chat-thread geometry -->
    <path
      class="signal-path"
      d="M-40 620 L180 620 L260 480 L380 480 L460 320 L580 320 L660 520 L780 520 L860 280 L980 280 L1060 400 L1180 400 L1260 240 L1480 240"
      fill="none"
      stroke="url(#signal-grad)"
      stroke-width="2.5"
      stroke-linecap="square"
      stroke-linejoin="miter"
      filter="url(#signal-glow)"
    />

    <!-- Secondary echo line (offset, quieter) -->
    <path
      class="signal-echo"
      d="M-40 660 L200 660 L280 540 L400 540 L480 400 L600 400 L680 580 L800 580 L880 360 L1000 360 L1080 460 L1200 460 L1280 320 L1480 320"
      fill="none"
      stroke="#2a5f56"
      stroke-width="1"
      stroke-linecap="square"
      opacity="0.55"
    />

    <!-- Pulse node traveling the primary path -->
    <circle class="signal-node" r="5" fill="#3dff9a" filter="url(#signal-glow)">
      <animateMotion
        dur="7s"
        repeatCount="indefinite"
        path="M-40 620 L180 620 L260 480 L380 480 L460 320 L580 320 L660 520 L780 520 L860 280 L980 280 L1060 400 L1180 400 L1260 240 L1480 240"
      />
    </circle>
  </svg>
</div>

<style>
  .signal-field {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .signal-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .signal-path {
    stroke-dasharray: 1800;
    stroke-dashoffset: 1800;
    animation: draw-signal 2.4s cubic-bezier(0.22, 1, 0.36, 1) 0.2s forwards;
  }

  .signal-echo {
    stroke-dasharray: 1800;
    stroke-dashoffset: 1800;
    animation: draw-signal 2.8s cubic-bezier(0.22, 1, 0.36, 1) 0.55s forwards;
  }

  .signal-grid {
    animation: grid-fade 1.6s ease-out both;
  }

  .signal-node {
    opacity: 0;
    animation: node-appear 0.4s ease-out 2.4s forwards;
  }

  @keyframes draw-signal {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes grid-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes node-appear {
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .signal-path,
    .signal-echo {
      stroke-dashoffset: 0;
      animation: none;
    }

    .signal-node {
      opacity: 1;
      animation: none;
    }

    .signal-node animateMotion {
      display: none;
    }

    .signal-grid {
      animation: none;
    }
  }
</style>
