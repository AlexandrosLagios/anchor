---
import '../styles/tokens.css';
import '../components/designs/slate/slate.css';
import { AuthNav } from '../components/AuthNav';
import { ConsentBanner } from '../components/ConsentBanner';
import { AccessibilityWidget } from '../components/AccessibilityWidget';

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
}

const {
  title,
  description = 'A keeper of the memories your family already shares in its group chat — so they can come back, in your own voices.',
  currentPath = '/',
} = Astro.props;

const fullTitle = title === 'Anchor' ? 'Anchor · family memories, returning' : `${title} · Anchor`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f9fafb" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{fullTitle}</title>
    <script is:inline>
      (function () {
        try {
          var raw = localStorage.getItem('anchor-a11y-prefs-v1');
          if (!raw) return;
          var p = JSON.parse(raw);
          var root = document.documentElement;
          var classes = [];
          if (p.textScale === 125 || p.textScale === 150) classes.push('a11y-text-' + p.textScale);
          if (p.spacing) classes.push('a11y-spacing');
          if (p.highContrast) classes.push('a11y-contrast');
          if (p.underlineLinks) classes.push('a11y-underline-links');
          if (p.readableFont) classes.push('a11y-readable-font');
          if (p.reduceMotion) classes.push('a11y-reduce-motion');
          if (p.bigCursor) classes.push('a11y-big-cursor');
          if (p.grayscale) classes.push('a11y-grayscale');
          if (p.hideImages) classes.push('a11y-hide-images');
          if (classes.length) root.classList.add.apply(root.classList, classes);
        } catch (e) {}
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400;1,700&family=Manrope:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body class="slate">
    <a class="slate-skip" href="#main">Skip to content</a>

    <header class="slate-header">
      <a class="slate-word" href="/">Anchor</a>
      <nav class="slate-nav" aria-label="Primary">
        <a href="/how-it-works" aria-current={currentPath === '/how-it-works' ? 'page' : undefined}>How it works</a>
        <a href="/app" aria-current={currentPath === '/app' ? 'page' : undefined}>Try the demo</a>
        <a href="/family" aria-current={currentPath === '/family' ? 'page' : undefined}>Family</a>
        <a href="/privacy" aria-current={currentPath === '/privacy' ? 'page' : undefined}>Privacy</a>
        <AuthNav client:load />
      </nav>
    </header>

    <main id="main" class="slate-main">
      <slot />
    </main>

    <footer class="slate-footer">
      <p>
        A keeper of the family’s own stories — returning gently so Nikos keeps his place in family life. Success is the
        contact those moments create, not time spent with Anchor.
      </p>
      <nav aria-label="Footer">
        <a href="/how-it-works">How it works</a>
        <a href="/app">Try the demo</a>
        <a href="/family">Family</a>
        <a href="/my-data">My data</a>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="/cookies">Cookies</a>
        <a href="/sitemap">Sitemap</a>
      </nav>
      <p class="a11y-note">
        Accessibility: this site aims for WCAG 2.1 Level AA. Use the Accessibility button for personal display settings
        on this device. Telegram’s own login window is outside our control; we only provide the button that opens it.
      </p>
    </footer>

    <AccessibilityWidget client:load />
    <ConsentBanner client:load />
  </body>
</html>
