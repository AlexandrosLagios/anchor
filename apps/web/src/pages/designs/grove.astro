---
import '../../components/designs/grove/grove.css';

const description =
  'Anchor brings family memories back in the group chat — spaced retrieval, gentle cues, no new app to learn.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#243828" />
    <meta property="og:title" content="Anchor · Olive grove (design E)" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>Anchor · Olive grove (design E)</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,400;0,600;0,700;1,400&family=Outfit:wght@600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="grove">
    <a class="grove-skip" href="#main">Skip to main content</a>

    <main id="main">
      <section class="grove-hero" aria-labelledby="grove-brand">
        <div class="grove-atmosphere" aria-hidden="true"></div>
        <div class="grove-canopy" aria-hidden="true"></div>
        <div class="grove-dapple" aria-hidden="true"></div>

        <header class="grove-header">
          <a class="grove-mark" href="/">Design E · Grove</a>
          <nav class="grove-nav" aria-label="Primary">
            <a href="/how-it-works">How it works</a>
            <a href="/app">Try the demo</a>
            <a href="/">Live site</a>
          </nav>
        </header>

        <div class="grove-copy">
          <h1 id="grove-brand" class="grove-brand">Anchor</h1>
          <p class="grove-line">Memories under the same sun.</p>
          <p class="grove-support">
            Spaced retrieval for Athina — gentle cues in the family chat, returning when the
            light is right.
          </p>
          <div class="grove-actions">
            <a class="grove-btn grove-btn-primary" href="/app">Try the demo</a>
            <a class="grove-btn grove-btn-secondary" href="/how-it-works">How it works</a>
          </div>
        </div>
      </section>

      <section class="grove-story" aria-labelledby="grove-story-title">
        <h2 id="grove-story-title">Kept in the family circle</h2>
        <p>
          Like an olive grove passed between generations, Anchor holds the family’s own stories
          and brings them back gently — so Athina stays grandmother in the same WhatsApp thread,
          not a patient of a new app.
        </p>
      </section>
    </main>

    <footer class="grove-footer">
      <p>
        Design variant E — olive grove / Mediterranean family. Not the production homepage.
      </p>
      <nav aria-label="Footer">
        <a href="/">Production home</a>
        <a href="/app">Demo</a>
        <a href="/privacy">Privacy</a>
      </nav>
    </footer>
  </body>
</html>
