---
import '../../components/designs/mist/mist.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Anchor — Mist</title>
    <meta
      name="description"
      content="Family memories, returning in the group chat. Spaced retrieval for Athina."
    />
  </head>
  <body class="mist">
    <a class="mist-skip" href="#mist-main">Skip to content</a>

    <main id="mist-main" class="mist-main">
      <div class="mist-panel">
        <h1 class="mist-brand">Anchor</h1>
        <p class="mist-line">Family memories, returning in the group chat.</p>
        <p class="mist-support">
          Spaced retrieval for Athina — gentle cues at the right time, without a
          new app to learn.
        </p>
        <nav class="mist-actions" aria-label="Primary">
          <a class="mist-btn mist-btn--primary" href="/app">Try the demo</a>
          <a class="mist-btn mist-btn--ghost" href="/how-it-works">How it works</a>
          <a class="mist-btn mist-btn--ghost" href="/family">Get started</a>
        </nav>
      </div>
    </main>
  </body>
</html>
