---
/**
 * Homepage design VARIANT — "Angle"
 * Route: /designs/angle
 * Direction: WhatsApp window / family chat as the product —
 * a quiet phone-scale conversation in a full-bleed room.
 * Does not replace the live homepage (index.astro).
 */
import '../../components/designs/angle/angle.css';

const title = 'Anchor · Angle (design)';
const description =
  'Family memories returning in the group chat you already use — Anchor as a quiet conversation on the table.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#4a5961" />
    <meta name="robots" content="noindex" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700&family=Work+Sans:ital,wght@0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="angle-root">
    <a class="angle-skip" href="#angle-main">Skip to main content</a>

    <header class="angle-chrome">
      <a class="angle-chrome-mark" href="/">Design · Angle</a>
      <nav class="angle-chrome-nav" aria-label="Primary">
        <a href="/how-it-works">How it works</a>
        <a href="/app">Try the demo</a>
        <a href="/">Live site</a>
      </nav>
    </header>

    <main id="angle-main">
      <section class="angle-hero" aria-labelledby="angle-brand">
        <div class="angle-room" aria-hidden="true"></div>

        <div class="angle-stage">
          <div class="angle-copy">
            <h1 id="angle-brand" class="angle-brand">Anchor</h1>
            <p class="angle-headline">The family chat is the product.</p>
            <p class="angle-support">
              Spaced retrieval for Athina — gentle cues that arrive in WhatsApp, without a new app to learn.
            </p>
            <div class="angle-actions">
              <a class="angle-btn angle-btn-primary" href="/app">Try the demo</a>
              <a class="angle-btn angle-btn-ghost" href="/how-it-works">How it works</a>
            </div>
          </div>

          <div class="angle-phone-wrap">
            <div
              class="angle-phone"
              role="img"
              aria-label="Phone showing the Papadopoulos family WhatsApp group: Sofia shares a market photo, then Anchor asks Athina who held her hand that morning."
            >
              <div class="angle-phone-notch" aria-hidden="true"></div>
              <div class="angle-screen" aria-hidden="true">
                <div class="angle-chat-bar">
                  <span class="angle-chat-avatar"></span>
                  <div class="angle-chat-meta">
                    <p class="angle-chat-name">Papadopoulos family</p>
                    <p class="angle-chat-status">Sofia, Nikos, Athina, Anchor</p>
                  </div>
                </div>

                <div class="angle-thread">
                  <p class="angle-day">Today</p>

                  <div class="angle-bubble angle-bubble-in angle-msg-1">
                    <p>Found this — Athina’s first morning at the market with Yiayia.</p>
                    <span class="angle-photo"></span>
                    <span class="angle-bubble-time">09:14</span>
                  </div>

                  <div class="angle-bubble angle-bubble-out angle-msg-2">
                    <p>I can still smell the oranges 🍊</p>
                    <span class="angle-bubble-time">09:16</span>
                  </div>

                  <div class="angle-bubble angle-bubble-anchor angle-msg-3">
                    <span class="angle-bubble-label">Anchor</span>
                    <p>Athina, who held your hand that morning?</p>
                    <span class="angle-bubble-time">11:02</span>
                  </div>
                </div>

                <div class="angle-composer">
                  <span class="angle-composer-field">Message</span>
                  <span class="angle-composer-send"></span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <p class="angle-note">
      Design variant · Angle · <a href="/">Back to live homepage</a>
    </p>
  </body>
</html>
