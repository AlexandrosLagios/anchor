---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../components/designs/coastal/coastal.css';
---

<BaseLayout
  title="Anchor"
  description="Family memories, returning gently — spaced retrieval in the group chat you already use."
  currentPath="/designs/coastal"
>
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Figtree:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <section class="coastal-page coastal-hero" aria-labelledby="coastal-brand">
    <div class="coastal-sky" aria-hidden="true"></div>
    <div class="coastal-haze" aria-hidden="true"></div>
    <div class="coastal-swell" aria-hidden="true"></div>

    <div class="coastal-copy">
      <h1 id="coastal-brand" class="coastal-brand">Anchor</h1>
      <p class="coastal-headline">Memories that drift back on the tide.</p>
      <p class="coastal-support">
        Gentle spaced cues in the family chat — so Athina keeps her place in the story, without a new app.
      </p>
      <div class="coastal-actions">
        <a class="coastal-btn coastal-btn-primary" href="/app">Try the demo</a>
        <a class="coastal-btn coastal-btn-ghost" href="/how-it-works">How it works</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* Soften the shared chrome so the coastal hero reads as one atmosphere */
  body:has(.coastal-hero) {
    background:
      linear-gradient(180deg, #b9d6e4 0%, #d7ebf2 35%, #eef7fa 100%);
  }

  body:has(.coastal-hero) .site-header .brand,
  body:has(.coastal-hero) .site-nav a {
    color: #163a48;
  }

  body:has(.coastal-hero) .site-footer {
    color: #3d5c68;
  }
</style>
