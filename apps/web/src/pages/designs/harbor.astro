---
/**
 * Homepage design VARIANT B — "Night harbor"
 * Route: /designs/harbor
 * Does not replace the live homepage (index.astro).
 */
import '../../components/designs/harbor/harbor.css';

const title = 'Anchor · Night harbor (design B)';
const description =
  'Family memories, returning in the group chat — spaced retrieval for Athina, without a new app to learn.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#060d18" />
    <meta name="robots" content="noindex" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="harbor-root">
    <a class="harbor-skip" href="#harbor-main">Skip to main content</a>

    <header class="harbor-chrome">
      <a class="harbor-chrome-mark" href="/">Design B</a>
      <nav class="harbor-chrome-nav" aria-label="Primary">
        <a href="/how-it-works">How it works</a>
        <a href="/app">Try the demo</a>
        <a href="/">Live site</a>
      </nav>
    </header>

    <main id="harbor-main">
      <section class="harbor-hero" aria-labelledby="harbor-brand">
        <div class="harbor-scene" aria-hidden="true">
          <div class="harbor-haze"></div>
          <div class="harbor-horizon"></div>
          <div class="harbor-lamps">
            <span class="harbor-lamp"></span>
            <span class="harbor-lamp"></span>
            <span class="harbor-lamp"></span>
          </div>
          <div class="harbor-water"></div>
        </div>

        <div class="harbor-copy">
          <h1 id="harbor-brand" class="harbor-brand">Anchor</h1>
          <p class="harbor-headline">Family memories, returning in the group chat.</p>
          <p class="harbor-support">
            Spaced retrieval for Athina — gentle cues at the right time, without a new app to learn.
          </p>
          <div class="harbor-actions">
            <a class="harbor-btn harbor-btn-primary" href="/app">Try the demo</a>
            <a class="harbor-btn harbor-btn-ghost" href="/how-it-works">How it works</a>
          </div>
        </div>
      </section>
    </main>

    <p class="harbor-note">
      Design variant B · <a href="/">Back to live homepage</a>
    </p>
  </body>
</html>
