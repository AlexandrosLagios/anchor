---
import '../../components/designs/ink/ink.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Anchor — Ink</title>
    <meta
      name="description"
      content="Family memories, returning in the group chat. Spaced retrieval for Athina."
    />
  </head>
  <body class="ink">
    <a class="ink-skip" href="#main">Skip to content</a>

    <header class="ink-header">
      <div class="ink-shell ink-header-inner">
        <a class="ink-mark" href="/designs/ink">Anchor</a>
        <nav aria-label="Primary">
          <ul class="ink-nav">
            <li><a href="/app">Demo</a></li>
            <li><a href="/how-it-works">How it works</a></li>
            <li><a href="/family">Get started</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="ink-main">
      <div class="ink-shell ink-grid">
        <h1 class="ink-hero-brand">Anchor</h1>

        <p class="ink-hero-line">Family memories, returning in the group chat.</p>

        <p class="ink-hero-support">
          Spaced retrieval for Athina — gentle cues at the right time, without a
          new app to learn.
        </p>

        <hr class="ink-rule" />

        <ul class="ink-actions" aria-label="Actions">
          <li>
            <a class="ink-action" href="/app">
              <span>Try the demo</span>
              <span class="ink-action-index" aria-hidden="true">01</span>
            </a>
          </li>
          <li>
            <a class="ink-action" href="/how-it-works">
              <span>How it works</span>
              <span class="ink-action-index" aria-hidden="true">02</span>
            </a>
          </li>
          <li>
            <a class="ink-action" href="/family">
              <span>Get started</span>
              <span class="ink-action-index" aria-hidden="true">03</span>
            </a>
          </li>
        </ul>

        <dl class="ink-meta">
          <dt>Style</dt>
          <dd>Ink — Swiss / international</dd>
        </dl>
      </div>
    </main>

    <footer class="ink-footer">
      <div class="ink-shell ink-footer-inner">
        <p>&copy; {new Date().getFullYear()} Anchor</p>
        <ul class="ink-footer-links">
          <li><a href="/privacy">Privacy</a></li>
          <li><a href="/terms">Terms</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>
