---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../components/flows/flows.css';

const cards = [
  {
    title: 'Share',
    body: 'A photo and a short line land in the group. Anchor saves the moment in the family’s words.',
  },
  {
    title: 'Consent',
    body: 'Nikos chooses what may return. Agreement is personal, not assumed for the whole chat.',
  },
  {
    title: 'Wait',
    body: 'Time passes on purpose. The record waits until a gentle cue will help, not interrupt.',
  },
  {
    title: 'Recall',
    body: 'Athina meets the moment again. Free recall first; a private cue only if she wants help.',
  },
  {
    title: 'Stay',
    body: 'She answers in the conversation she already knows. No new app. No public score.',
  },
];
---

<BaseLayout
  title="Horizontal strip"
  description="Snap-scrolling horizontal narrative strip for Anchor’s journey."
  currentPath="/flows/strip"
  wide
>
  <section class="flow-intro">
    <p class="flow-kicker">Flow 2 · Strip</p>
    <h1>Horizontal strip</h1>
    <p>
      Scroll sideways through the journey. Each card snaps into place — useful when the story is a sequence of short
      beats rather than long sections.
    </p>
  </section>
  <p class="strip-hint">Swipe or scroll horizontally. Keyboard: focus the strip, then use arrow keys where supported.</p>
  <div class="strip-track" tabindex="0" role="list" aria-label="Anchor journey as a horizontal strip">
    {
      cards.map((card) => (
        <article class="strip-card" role="listitem">
          <h2>{card.title}</h2>
          <p>{card.body}</p>
        </article>
      ))
    }
  </div>
</BaseLayout>
