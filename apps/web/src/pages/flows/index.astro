---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../components/flows/flows.css';

const flows = [
  {
    href: '/flows/chapters',
    title: 'Scroll chapters',
    blurb: 'Sticky chapter rail that tracks which story beat is in view — common on awarded long-scroll sites.',
  },
  {
    href: '/flows/strip',
    title: 'Horizontal strip',
    blurb: 'Snap-scrolling cards for a paced narrative without burying beats down the page.',
  },
  {
    href: '/flows/timeline',
    title: 'Expand timeline',
    blurb: 'Progressive disclosure: each beat opens in place so older adults control the pace.',
  },
  {
    href: '/flows/split',
    title: 'Split reveal',
    blurb: 'Two sticky panes stay visible while the story scrolls — family chat and Athina together.',
  },
  {
    href: '/flows/cascade',
    title: 'Beat cascade',
    blurb: 'A stacked card deck that advances one beat at a time, like a guided demo.',
  },
];
---

<BaseLayout
  title="Content flows"
  description="Five content-flow demos for Anchor, inspired by awarded storytelling websites."
  currentPath="/flows"
  wide
>
  <section class="flow-intro">
    <p class="flow-kicker">Experiments</p>
    <h1>Better content flow systems</h1>
    <p>
      Five ways to tell Anchor’s story. Patterns drawn from awarded scroll sites: chapter tracking, horizontal
      narrative, expandable timelines, split sync, and stacked beats.
    </p>
    <p class="flow-ref">
      References: recent Awwwards Site of the Day storytelling (e.g. Locomotive-style chapters, studio portfolios with
      snap strips). Adapted here for family memory, not spectacle.
    </p>
  </section>

  <div class="flow-grid">
    {
      flows.map((flow) => (
        <a class="flow-card" href={flow.href}>
          <h2>{flow.title}</h2>
          <p>{flow.blurb}</p>
          <span>Open demo</span>
        </a>
      ))
    }
  </div>
</BaseLayout>
