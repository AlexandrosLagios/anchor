---
import BaseLayout from '../layouts/BaseLayout.astro';
import { MvpDemo } from '../components/MvpDemo';
---

<BaseLayout
  title="Demo"
  description="Sofia shares Maria’s first day. Nikos agrees himself, meets the moment again, and answers by voice."
  currentPath="/app"
>
  <div class="app-wrap">
    <MvpDemo client:load />
  </div>
</BaseLayout>

<style>
  .app-wrap {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 var(--space) calc(var(--space) * 2);
  }
</style>
