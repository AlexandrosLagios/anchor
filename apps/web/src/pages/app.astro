---
import BaseLayout from '../layouts/BaseLayout.astro';
import { MvpDemo } from '../components/MvpDemo';
---

<BaseLayout
  title="Demo"
  description="Sofia shares Maria’s first day. Nikos agrees himself, meets the moment again, and answers by voice."
  currentPath="/app"
>
  <div class="app-wrap">
    <MvpDemo client:load />
  </div>
</BaseLayout>

<style>
  .app-wrap {
    max-width: none;
    margin: 0;
    padding: 0 0 calc(var(--space) * 1.5);
  }
</style>
