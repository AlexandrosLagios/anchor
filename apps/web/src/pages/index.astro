---
import BaseLayout from '../layouts/BaseLayout.astro';

const description =
  'A keeper of the memories your family already shares in its group chat — so they can come back, in your own voices.';
---

<BaseLayout title="Anchor" description={description} currentPath="/">
  <section class="slate-hero" aria-labelledby="slate-title">
    <p class="slate-brand" aria-hidden="true">Anchor</p>
    <h1 id="slate-title" class="slate-line">Family memories, returning in the group chat.</h1>
    <p class="slate-support">
      Anchor keeps what the family already shares — photos, stories, voice notes — and brings them back so everyone can
      relive them together. It is a keeper of memories, not a person and not a member of the family. The warmth comes
      from you.
    </p>
    <div class="slate-actions">
      <a class="slate-btn slate-btn-primary" href="/family">Get started</a>
      <a class="slate-btn slate-btn-ghost" href="/app">Try the demo</a>
      <a class="slate-btn slate-btn-ghost" href="/how-it-works">How it works</a>
    </div>
  </section>

  <section class="slate-section" aria-labelledby="how-it-works">
    <h2 id="how-it-works" class="slate-heading">How it works</h2>
    <ol class="slate-steps">
      <li>
        <span class="slate-step-num" aria-hidden="true">1</span>
        <p>
          The family invites Anchor together. Nikos knows what it is — a keeper of photos and stories — and is part of
          that decision.
        </p>
      </li>
      <li>
        <span class="slate-step-num" aria-hidden="true">2</span>
        <p>
          Sofia posts Maria’s first day of school. Later, Nikos shares a memory of his own. Anchor keeps each moment in
          the sender’s words.
        </p>
      </li>
      <li>
        <span class="slate-step-num" aria-hidden="true">3</span>
        <p>
          Moments come back as invitations to relive them — not questions with a right answer. When Nikos adds a detail,
          the family talks again.
        </p>
      </li>
    </ol>
  </section>

  <section class="slate-section" aria-labelledby="what-comes-back">
    <h2 id="what-comes-back" class="slate-heading">What comes back</h2>
    <p class="slate-section-lead">
      The same kinds of things the family already shares — an invitation to revisit, never a quiz.
    </p>
    <ul class="slate-list">
      <li>Memories and stories in the words of the person who shared them</li>
      <li>Photos from ordinary days and bigger ones</li>
      <li>Voice notes in familiar voices</li>
      <li>Moments that lead back to people — a reply in the group, a call — not more time with Anchor</li>
    </ul>
  </section>

  <section class="slate-section" aria-labelledby="choices">
    <h2 id="choices" class="slate-heading">Choices stay with him</h2>
    <p class="slate-prose">
      Some memories are tender. Nikos chooses, with the family’s support, which ones may come back, and that choice can
      change. Choices and stop live in Telegram with Anchor. On this website you register with email, add the bot, and
      read the family record. Sensitive moments are hidden from the shared list; export on{' '}
      <a class="slate-link" href="/my-data">My data</a> includes them for the person who shared them.
    </p>
  </section>

  <section class="slate-section" aria-labelledby="where-data-lives">
    <h2 id="where-data-lives" class="slate-heading">Where data lives</h2>
    <p class="slate-prose">
      You register with email first. Account data sits in Neon in the EU. The Telegram family record sits with the bot on
      Cloud Run in the EU (<code>europe-west1</code>), in Cloud Storage. Prompts sent to OpenAI may leave the EU when the
      model runs. More detail is on the <a class="slate-link" href="/privacy">privacy page</a>.
    </p>
  </section>

  <section class="slate-section slate-close" aria-labelledby="slate-close">
    <h2 id="slate-close" class="slate-heading slate-heading-soft">Keep the family talking.</h2>
    <p class="slate-section-lead">
      Create an account, add Anchor to the group chat the family already uses, then share a moment.
    </p>
    <div class="slate-actions">
      <a class="slate-btn slate-btn-primary" href="/family">Get started</a>
      <a class="slate-btn slate-btn-ghost" href="/app">Try the demo</a>
      <a class="slate-btn slate-btn-ghost" href="/how-it-works">How it works</a>
    </div>
  </section>
</BaseLayout>
