PUBLIC_PRIVACY_EMAIL=privacy@anchor.com
# Match REQUIRE_AUTH on the API. false keeps the local demo open; production uses true.
PUBLIC_REQUIRE_AUTH=false
PUBLIC_DATA_REGION=eu-central-1
PUBLIC_SITE_URL=http://localhost:4321
# Leave empty locally (Astro proxies /api → :3000). Production builds default to the Nest host.
# Set this explicitly on Vercel when the API URL changes.
PUBLIC_API_URL=
