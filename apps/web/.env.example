# Public Firebase web config from the Firebase Console web-app SDK snippet.
# The apiKey field is Firebase's browser client config (auto-created with the web app),
# not a Cloud "API key" you create under Credentials. Backend uses ADC instead.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_PRIVACY_EMAIL=privacy@anchor.com
PUBLIC_REQUIRE_AUTH=false
